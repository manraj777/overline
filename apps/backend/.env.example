# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://overline:overline_dev_password@localhost:5440/overline?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# If your provider uses password-only auth, prefer redis://:password@host:port
# Avoid redis://default:password@... unless ACL username is explicitly enabled.
REDIS_URL=

# JWT
# Base64-encoded secret (decoded length must be >= 32 bytes)
JWT_SECRET=replace-with-base64-encoded-secret
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Passwords
BCRYPT_SALT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
BACKEND_URL=http://localhost:3001
USER_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3002
# Backward compatible aliases
USER_FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3002

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Payment - Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Payment - Razorpay (India)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_ROUTE_ENABLED=true
RAZORPAY_ACCOUNT_NUMBER=

# Platform fee percentage deducted from online staff payouts
PLATFORM_FEE_PERCENT=2

# Email - SendGrid
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# SMS - Twilio
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE=+1234567890
TWILIO_PHONE_NUMBER=+1234567890

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Firebase Admin (for phone auth token exchange)
FIREBASE_PROJECT_ID=
# Base64-encoded Firebase service account JSON
FIREBASE_SERVICE_ACCOUNT_KEY=

# Cloudinary Uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Set to true to fail app startup when Cloudinary vars are missing
REQUIRE_CLOUDINARY=false

# Push Notifications - Firebase
FCM_SERVER_KEY=

# Web Push
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_EMAIL=

# Frontend runtime (used by web apps)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Maps
GOOGLE_MAPS_API_KEY=
