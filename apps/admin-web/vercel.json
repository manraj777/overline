{
  "framework": "nextjs",
  "installCommand": "cd /vercel/path0 && corepack enable && corepack prepare pnpm@10.11.0 --activate && pnpm install --filter @overline/admin-web... --prod=false --no-frozen-lockfile",
  "buildCommand": "cd /vercel/path0 && pnpm --filter @overline/admin-web build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://overlinebackend-production.up.railway.app/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
