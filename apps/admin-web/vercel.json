{
  "framework": "nextjs",
  "installCommand": "cd /vercel/path0 && corepack enable && npx pnpm@9.15.4 --version && npx pnpm@9.15.4 install --prod=false --frozen-lockfile",
  "buildCommand": "cd /vercel/path0 && pnpm --filter @overline/admin-web build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.overline.in/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
